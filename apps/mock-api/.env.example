# Port and allowed browser origins.
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Speeds up (<1) or slows down (>1) the simulated waiting room.
QUEUE_TIME_SCALE=1
# How long seats are held during checkout.
HOLD_MINUTES=10
# Exposes /api/__test__/* (reset, pay a Fawry bill, cancel an event). Never enable in production.
ENABLE_TEST_ROUTES=true
# How long the simulated identity check and wallet / InstaPay approvals take.
FAN_ID_REVIEW_SECONDS=5
PAYMENT_APPROVAL_SECONDS=3
# Failed logins allowed per number per 15 minutes.
LOGIN_ATTEMPTS=5
# HMAC secret for rotating entry QR codes (required when NODE_ENV=production).
# QR_SECRET=
