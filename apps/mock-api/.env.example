# Port the mock API listens on
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Speeds up (<1) or slows down (>1) the simulated waiting room
QUEUE_TIME_SCALE=1
# Minutes a ticket hold lasts before seats are released
HOLD_MINUTES=10
# Exposes POST /api/__test__/reset (always disabled when NODE_ENV=production unless set to true)
ENABLE_TEST_ROUTES=true
