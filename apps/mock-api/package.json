{
  "name": "mock-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mocked Matchpass REST API (Express + TypeScript) used for local development, tests and E2E.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@repo/contracts": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
