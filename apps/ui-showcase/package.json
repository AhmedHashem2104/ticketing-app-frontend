{
  "name": "ui-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Storybook for the Matchpass design system (atoms \u2192 pages), built on Vite.",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir storybook-static",
    "preview": "npx http-server storybook-static -p 6006",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/design-system": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
