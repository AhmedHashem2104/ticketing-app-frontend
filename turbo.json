{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_OUTPUT"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_ORIGIN",
        "PORT",
        "CORS_ORIGIN",
        "QUEUE_TIME_SCALE",
        "HOLD_MINUTES",
        "ENABLE_TEST_ROUTES",
        "FEATURE_FLAGS_FILE"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_ORIGIN",
        "PORT",
        "CORS_ORIGIN",
        "QUEUE_TIME_SCALE",
        "HOLD_MINUTES",
        "ENABLE_TEST_ROUTES",
        "FEATURE_FLAGS_FILE",
        "NODE_ENV"
      ]
    }
  }
}
