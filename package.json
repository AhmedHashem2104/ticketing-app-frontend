{
  "name": "ticketing-app-frontend-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=matchpass-web --filter=mock-api",
    "dev:showcase": "turbo run dev --filter=ui-showcase",
    "start": "turbo run start --filter=matchpass-web --filter=mock-api",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "verify": "turbo run lint check-types test build",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
